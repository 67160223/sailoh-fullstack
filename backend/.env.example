# PostgreSQL (ต้องตรงกับ docker-compose.yml)
POSTGRES_USER=sailoh
POSTGRES_PASSWORD=sailoh_secret
POSTGRES_DB=sailoh_db
DATABASE_URL=postgresql://sailoh:sailoh_secret@db:5432/sailoh_db?schema=public

# App
PORT=4000
NODE_ENV=production

# JWT — เปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริงเสมอ
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_RESET_SECRET=change_this_reset_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_RESET_EXPIRES=15m

# CORS — โดเมน frontend ที่อนุญาต (คั่นด้วย comma)
CORS_ORIGIN=http://localhost:5173

# pgAdmin (ใช้ตอน docker compose ขึ้น pgadmin)
PGADMIN_DEFAULT_EMAIL=admin@sailoh.local
PGADMIN_DEFAULT_PASSWORD=admin_secret
